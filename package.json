{
  "name": "dsh-opendesign-go",
  "version": "0.1.7",
  "description": "OpenDesign Go plan model provider, usage display and account management for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliteOtaku/dsh-opendesign-go.git"
  },
  "homepage": "https://github.com/EliteOtaku/dsh-opendesign-go#readme",
  "bugs": {
    "url": "https://github.com/EliteOtaku/dsh-opendesign-go/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-settings-controller"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "opendesign",
    "llm",
    "cordis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run compile",
    "verify:load": "node scripts/plugin-smoke.mjs",
    "test:ci": "npm run check:dist && vitest run && npm run verify:load",
    "test:hosts": "node scripts/host-matrix.mjs",
    "prepublishOnly": "npm run check:dist",
    "sync:profile": "node scripts/sync-profile.mjs --profile desktop",
    "sync:link": "node scripts/sync-profile.mjs --profile desktop --link",
    "link:profile": "node scripts/link-profile.mjs --profile desktop"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-settings-controller": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.2.1-rc.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
