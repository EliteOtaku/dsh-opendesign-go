{
  "name": "dsh-opendesign-go",
  "version": "0.0.1",
  "description": "OpenDesign Go plan model provider, usage display and account management for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliteOtaku/dsh-opendesign-go.git"
  },
  "homepage": "https://github.com/EliteOtaku/dsh-opendesign-go#readme",
  "bugs": {
    "url": "https://github.com/EliteOtaku/dsh-opendesign-go/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "docs",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "opendesign",
    "llm",
    "cordis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run compile",
    "verify:load": "node scripts/plugin-smoke.mjs",
    "test:ci": "npm run check:dist && vitest run && npm run verify:load",
    "prepublishOnly": "npm run check:dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
